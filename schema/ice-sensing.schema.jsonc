        // "include_spectrum": { "type": "boolean" },
      }
    },
    "config": {
      "type": "object",
      "description": "Effective device configuration (reported by the device, or sent inside a set_config command).",
      "additionalProperties": false,
      "properties": {
        // "config_id": { "$ref": "#/$defs/id" },
        "config_version": { "type": "integer", "minimum": 0 },
        // "applied_ts": { "$ref": "#/$defs/epoch_ms" },
        "reporting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "telemetry_interval_s": { "type": "number", "exclusiveMinimum": 0 },
            // "status_interval_s": { "type": "number", "exclusiveMinimum": 0 },
            // "heartbeat_interval_s": { "type": "number", "exclusiveMinimum": 0 },
            // "window_duration_ms": { "type": "integer", "minimum": 1 },
