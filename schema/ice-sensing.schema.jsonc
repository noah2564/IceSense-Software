        // "power": { "$ref": "#/$defs/power" },
        "connectivity": { "$ref": "#/$defs/connectivity" },
        "system": { "$ref": "#/$defs/system" },
        "buffering": { "$ref": "#/$defs/buffering" },
        "sensors": { "type": "array", "items": { "$ref": "#/$defs/sensor_status" } },
