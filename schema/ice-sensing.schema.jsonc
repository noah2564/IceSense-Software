        // "acknowledged": { "type": "boolean" },
        "details": { "type": "object", "description": "Free-form extra data for the event.", "additionalProperties": true },
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        // "source": { "type": "string", "enum": ["mains_dc", "battery", "poe", "usb", "solar", "24vac_rectified", "other"] },
        // "supply_v": { "type": "number", "minimum": 0 },
