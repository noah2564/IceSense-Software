        "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "aggregation": { "type": "string", "enum": ["instant", "mean", "median", "min", "max", "rms", "decimated", "raw_block", "mixed"] },
        "trigger": {
          "type": "string",
          "enum": ["periodic", "on_change", "on_threshold", "on_command", "on_hvac_event", "on_boot", "adaptive_fast"]
        },
      }
    },
    "environment": {
      "type": "object",
      "description": "Environmental context relevant to ice formation (also available as separate channels; use whichever is cheaper).",
