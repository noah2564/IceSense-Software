    "event": {
      "type": "object",
      "required": ["event_type", "severity"],
      "additionalProperties": false,
      "properties": {
        // "event_id": { "$ref": "#/$defs/id" },
        "event_type": {
          "type": "string",
          "enum": ["ice_detected", "ice_cleared", "frost_detected", "frost_cleared", "ice_state_changed", "defrost_recommended", "defrost_started", "defrost_ended", "hvac_mode_changed", "coil_blocked", "threshold_crossed", "rapid_change", "baseline_updated", "baseline_drift_warning", "sensor_fault", "sensor_recovered", "electrode_damage_suspected", "calibration_required", "calibration_started", "calibration_completed", "connectivity_lost", "connectivity_restored", "time_sync_lost", "time_synced", "buffer_overflow", "brownout", "low_supply", "watchdog_reset", "reset", "boot", "config_changed", "ota_started", "ota_completed", "ota_failed", "ota_rolled_back", "self_test_failed", "tamper", "other"]
        },
        "severity": { "type": "string", "enum": ["debug", "info", "notice", "warning", "alarm", "critical"] },
        "state": {
          "type": "string",
          "enum": ["instant", "raised", "ongoing", "cleared"],
          "description": "Alarm lifecycle: 'raised' when condition starts, 'cleared' when it ends."
