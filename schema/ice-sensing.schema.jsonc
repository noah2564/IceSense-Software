        // },
        // "growth_rate_mm_per_h": { "type": "number" },
        // "time_to_blockage_s_est": { "type": "integer", "minimum": 0 },
        "defrost_recommended": { "type": "boolean" },
        // "defrost_urgency": { "type": "string", "enum": ["none", "low", "medium", "high", "immediate"] },
        // "state_since_ts": { "$ref": "#/$defs/epoch_ms" },
        "state_duration_s": { "type": "integer", "minimum": 0 },
        "previous_state": {
          "type": "string",
          "enum": ["clear", "dry", "wet", "condensation", "frost_onset", "frost", "ice", "heavy_ice", "blocked", "melting", "unknown"]
        },
        "algorithm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 64 },
            "version": { "type": "string", "maxLength": 32 },
            "model_id": { "type": "string", "maxLength": 64 },
            "type": { "type": "string", "enum": ["threshold", "rule_based", "decision_tree", "ml_model", "fusion", "other"] },
          }
        },
        // "input_channels": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "features": {
          "type": "object",
          "description": "Named numeric features the decision was based on (e.g. delta_c_pf, delta_r_log10, phase_at_1khz_deg, c_ratio_hi_lo, dT_dt).",
          "additionalProperties": { "type": "number" }
        },
        // "thresholds_applied": { "type": "array", "items": { "$ref": "#/$defs/threshold" } },
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["window", "channels"],
      "additionalProperties": false,
      "properties": {
        "window": { "$ref": "#/$defs/window" },
        "channels": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/channel" } },
