    "window": {
      "type": "object",
      "description": "Time window the telemetry values refer to.",
      "required": ["start_ts", "end_ts"],
      "additionalProperties": false,
      "properties": {
        "start_ts": { "$ref": "#/$defs/epoch_ms" },
        "end_ts": { "$ref": "#/$defs/epoch_ms" },
