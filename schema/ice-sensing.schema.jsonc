/*
  ICE-SENSING MESSAGE SCHEMA: source file  (edit THIS file, never the generated .json)

  How it works
    * JSON has no comments, so this is JSONC. `python3 build_schema.py` strips the comments and
      writes ice-sensing.schema.json, which the server, the tests and the host check load.
    * Every line starting with `//` is a property (or message type) that is switched OFF because
      nothing sends or reads it yet. Only properties used by the current firmware, simulator and
      server are active.
    * To switch one on: delete the leading `// ` on its line(s), run build_schema.py.
      Commas are safe either way (trailing commas are allowed in this file).
    * A property whose value is a "$ref" needs that definition under "$defs" as well. The
      definitions are all present; inside them every property is commented the same way, so
      enable only the fields you need. build_schema.py refuses to build if a "required" entry
      points at a property that is still commented out.
    * `python3 build_schema.py --enable-all FILE` writes the complete schema (everything on).
    * Enum VALUES (event types, quality flags, command types, ...) are not commented out. Only
      property names and message types are, because those decide what a message may contain.

  Contract rules (unchanged): omit unavailable fields, never null/NaN; timestamps are UTC epoch ms;
  units are in the field names; unknown fields are rejected except top-level "x_" extensions.
*/
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ice-sensing/1.0.0/message.schema.json",
  "title": "HVAC Ice-Sensing Device Message",
  "description": "Envelope + payload for all messages sent between an ESP32 ice-sensing node (capacitive / resistive / impedance / thermal sensing of frost and ice on HVAC coils) and the backend. RULES: (1) Omit unavailable fields; never send null or NaN. (2) All timestamps are UTC epoch milliseconds. (3) Units are encoded in field-name suffixes (_pf, _ohm, _c, _hz, _ms, _pct, ...). (4) Unknown fields are rejected except top-level 'x_' vendor extensions. (5) Additive changes bump the minor version, breaking changes the major version.",
  "type": "object",
  "required": ["schema_version", "message_type", "message_id", "device_id", "seq", "ts"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$", "description": "Semantic version of this schema, e.g. 1.0.0" },
    "message_type": {
      "type": "string",
      "enum": [
        "telemetry",
        "event",
        "status",
        // "heartbeat",
        // "config",
        "command",
        "command_ack",
        "calibration",
        // "diagnostic",
        // "log",
      ]
    },
    "message_id": {
      "$ref": "#/$defs/id",
      "description": "Unique per message (UUID or device_id + boot_count + seq). Used for de-duplication."
    },
    "device_id": { "$ref": "#/$defs/id", "description": "Stable unique device identity (e.g. derived from ESP32 eFuse MAC)." },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-device message counter, restarting at 0 on every boot, so (boot_count, seq) is unique. Gaps within one boot indicate lost messages."
    },
    "boot_count": { "type": "integer", "minimum": 0, "description": "Incremented on every boot; (boot_count, seq) is unique." },
    "ts": { "$ref": "#/$defs/epoch_ms", "description": "Time the message was created on the device." },
    "ts_source": {
      "type": "string",
      "enum": ["ntp", "sntp", "rtc", "gps", "server_sync", "manual", "uptime_only"],
      "description": "How trustworthy ts is. 'uptime_only' means ts is not wall-clock; use uptime_ms."
    },
    "uptime_ms": { "type": "integer", "minimum": 0 },
    // "time_info": { "$ref": "#/$defs/time_info" },
    // "asset": { "$ref": "#/$defs/asset" },
    "firmware": { "$ref": "#/$defs/firmware" },
    "config_version": { "type": "integer", "minimum": 0, "description": "Version of the configuration active when the message was produced." },
    "in_reply_to": { "$ref": "#/$defs/id", "description": "command_id this message answers, if any." },
    "buffered": {
      "type": "boolean",
      "description": "True if the message was stored on the device and sent late (ts is then older than arrival time)."
    },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "event": { "$ref": "#/$defs/event" },
    "status": { "$ref": "#/$defs/status" },
    // "config": { "$ref": "#/$defs/config" },
    "command": { "$ref": "#/$defs/command" },
    "command_ack": { "$ref": "#/$defs/command_ack" },
    "calibration": { "$ref": "#/$defs/calibration" },
    // "diagnostic": { "$ref": "#/$defs/diagnostic" },
    // "log": { "$ref": "#/$defs/log" },
  },
  "patternProperties": { "^x_": {} },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "message_type": { "const": "telemetry" } } }, "then": { "required": ["telemetry"] } },
    { "if": { "properties": { "message_type": { "const": "event" } } }, "then": { "required": ["event"] } },
    { "if": { "properties": { "message_type": { "const": "status" } } }, "then": { "required": ["status"] } },
    // { "if": { "properties": { "message_type": { "const": "config" } } }, "then": { "required": ["config"] } },
    { "if": { "properties": { "message_type": { "const": "command" } } }, "then": { "required": ["command"] } },
    { "if": { "properties": { "message_type": { "const": "command_ack" } } }, "then": { "required": ["command_ack"] } },
    { "if": { "properties": { "message_type": { "const": "calibration" } } }, "then": { "required": ["calibration"] } },
    // { "if": { "properties": { "message_type": { "const": "diagnostic" } } }, "then": { "required": ["diagnostic"] } },
    // { "if": { "properties": { "message_type": { "const": "log" } } }, "then": { "required": ["log"] } },
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "epoch_ms": { "type": "integer", "minimum": 0, "description": "UTC milliseconds since 1970-01-01T00:00:00Z" },
    "pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "unit_interval": { "type": "number", "minimum": 0, "maximum": 1 },
    "time_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        // "last_sync_ts": { "$ref": "#/$defs/epoch_ms" },
        // "sync_age_s": { "type": "integer", "minimum": 0 },
        // "offset_ms": { "type": "number", "description": "Last measured offset to the time server (device minus server)." },
        // "drift_ppm": { "type": "number" },
        // "ntp_server": { "type": "string", "maxLength": 128 },
        // "synced": { "type": "boolean" },
      }
    },
    "asset": {
      "type": "object",
      "description": "Where the device is installed and what it monitors.",
      "additionalProperties": false,
      "properties": {
        // "site_id": { "$ref": "#/$defs/id" },
        // "building": { "type": "string", "maxLength": 64 },
        // "hvac_unit_id": { "$ref": "#/$defs/id" },
        // "hvac_unit_type": {
        //   "type": "string",
        //   "enum": ["air_handling_unit", "heat_pump_outdoor", "heat_pump_indoor", "evaporator_coil", "condenser_coil", "chiller", "refrigeration_evaporator", "heat_recovery_exchanger", "fan_coil", "rooftop_unit", "other"]
        // },
        // "coil_id": { "$ref": "#/$defs/id" },
        // "coil_section": { "type": "string", "maxLength": 32, "description": "e.g. inlet_row_1, outlet_row_4, circuit_A" },
        // "zone": { "type": "string", "maxLength": 64 },
        // "install_height_mm": { "type": "number" },
        // "fin_pitch_mm": { "type": "number", "exclusiveMinimum": 0 },
        // "fin_material": { "type": "string", "enum": ["aluminium", "copper", "coated_aluminium", "steel", "other"] },
        // "refrigerant": { "type": "string", "maxLength": 16, "description": "e.g. R32, R410A, R290, glycol_30" },
        // "description": { "type": "string", "maxLength": 256 },
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "maxLength": 32 },
        // "build_id": { "type": "string", "maxLength": 64 },
        // "git_hash": { "type": "string", "maxLength": 40 },
        // "build_ts": { "$ref": "#/$defs/epoch_ms" },
        "idf_version": { "type": "string", "maxLength": 32 },
        // "hardware_revision": { "type": "string", "maxLength": 32 },
        "chip": { "type": "string", "enum": ["ESP32", "ESP32-S2", "ESP32-S3", "ESP32-C3", "ESP32-C6", "other"] },
        // "chip_revision": { "type": "string", "maxLength": 16 },
        // "algorithm_version": { "type": "string", "maxLength": 32 },
        // "partition": { "type": "string", "enum": ["ota_0", "ota_1", "factory"] },
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["good", "uncertain", "bad", "substituted", "stale", "calibrating", "disabled"] },
        // "score": { "$ref": "#/$defs/unit_interval", "description": "Optional 0..1 data-quality score from the device." },
        // "snr_db": { "type": "number" },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["saturated", "adc_clipped", "open_circuit", "short_circuit", "out_of_range", "noisy", "drifting", "stuck_value", "emi_suspected", "mains_interference", "wet_electrode", "condensation_suspected", "temperature_out_of_range", "baseline_invalid", "baseline_stale", "timing_jitter", "sensor_disconnected", "low_supply", "reference_out_of_tolerance", "compensation_unavailable", "interpolated"]
          }
        },
      }
    },
    "statistics": {
      "type": "object",
      "description": "Statistics over the sampling window for the primary value of the channel.",
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "mean": { "type": "number" },
        // "median": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "std": { "type": "number", "minimum": 0 },
        // "rms": { "type": "number", "minimum": 0 },
        // "peak_to_peak": { "type": "number", "minimum": 0 },
        // "p05": { "type": "number" },
        // "p95": { "type": "number" },
        // "slope_per_s": { "type": "number", "description": "Linear trend over the window, in value units per second." },
        // "noise_floor": { "type": "number", "minimum": 0 },
        // "outlier_count": { "type": "integer", "minimum": 0 },
        // "first_value": { "type": "number" },
        // "last_value": { "type": "number" },
      }
    },
    "waveform": {
      "type": "object",
      "description": "Raw or decimated time-domain samples, for offline analysis. Large blocks may be split into chunks.",
      "required": ["encoding", "sample_rate_hz", "sample_count", "data"],
      "additionalProperties": false,
      "properties": {
        // "waveform_id": { "$ref": "#/$defs/id" },
        // "start_ts": { "$ref": "#/$defs/epoch_ms" },
        // "encoding": {
        //   "type": "string",
        //   "enum": ["json_array", "base64_int16_le", "base64_uint16_le", "base64_int32_le", "base64_uint32_le", "base64_float32_le"]
        // },
        // "compression": { "type": "string", "enum": ["none", "deflate", "lz4"], "default": "none" },
        // "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        // "sample_count": { "type": "integer", "minimum": 1 },
        // "scale": { "type": "number", "default": 1, "description": "physical = raw * scale + offset" },
        // "offset": { "type": "number", "default": 0 },
        // "unit": { "type": "string", "maxLength": 16 },
        // "quantity": {
        //   "type": "string",
        //   "enum": ["raw_counts", "capacitance_pf", "resistance_ohm", "voltage_v", "current_ua", "frequency_hz", "period_us", "temperature_c", "other"]
        // },
        // "chunk_index": { "type": "integer", "minimum": 0 },
        // "chunk_count": { "type": "integer", "minimum": 1 },
        // "crc32": { "type": "string", "pattern": "^[0-9a-fA-F]{8}$" },
        // "data": { "oneOf": [{ "type": "array", "items": { "type": "number" } }, { "type": "string" }] },
      }
    },
    "spectrum": {
      "type": "object",
      "description": "Frequency-domain representation (FFT of a raw channel, e.g. to detect mains pickup or fan vibration).",
      "required": ["bin_hz", "magnitudes"],
      "additionalProperties": false,
      "properties": {
        // "bin_hz": { "type": "number", "exclusiveMinimum": 0 },
        // "start_hz": { "type": "number", "minimum": 0 },
        // "fft_size": { "type": "integer", "minimum": 2 },
        // "window": { "type": "string", "enum": ["rectangular", "hann", "hamming", "blackman", "flattop"] },
        // "magnitudes": { "type": "array", "items": { "type": "number" } },
        // "dominant_hz": { "type": "number", "minimum": 0 },
        // "dominant_magnitude": { "type": "number" },
        // "mains_peak_hz": { "type": "number" },
        // "unit": { "type": "string", "maxLength": 16 },
      }
    },
    "excitation": {
      "type": "object",
      "description": "Stimulus applied to the electrode / sensor.",
      "additionalProperties": false,
      "properties": {
        // "waveform": { "type": "string", "enum": ["dc", "square", "sine", "triangle", "pulse", "charge_discharge", "none"] },
        // "frequency_hz": { "type": "number", "minimum": 0 },
        // "amplitude_v": { "type": "number", "minimum": 0 },
        // "offset_v": { "type": "number" },
        // "current_ua": { "type": "number", "minimum": 0 },
        // "duty_pct": { "$ref": "#/$defs/pct" },
        // "polarity_reversal": { "type": "boolean", "description": "Alternating polarity to avoid electrolysis/polarisation on resistive electrodes." },
        // "polarity": { "type": "string", "enum": ["positive", "negative", "alternating"] },
        // "burst_length_us": { "type": "number", "minimum": 0 },
        // "settling_time_us": { "type": "number", "minimum": 0 },
        // "duty_cycled": { "type": "boolean", "description": "Excitation only enabled during the measurement (saves power, reduces corrosion)." },
      }
    },
    "front_end": {
      "type": "object",
      "description": "Measurement hardware and settings used for the channel.",
      "additionalProperties": false,
      "properties": {
        // "type": {
        //   "type": "string",
        //   "enum": ["esp32_touch", "esp32_adc", "esp32_adc_calibrated", "external_adc", "cdc_fdc1004", "cdc_fdc2214", "cdc_ad7745", "cdc_pcap", "impedance_ad5933", "impedance_ad5940", "cap_touch_ic", "rc_oscillator", "charge_transfer", "resistive_divider", "wheatstone_bridge", "ac_bridge", "current_source", "other"]
        // },
        // "part_number": { "type": "string", "maxLength": 32 },
        // "mode": {
        //   "type": "string",
        //   "enum": ["self_capacitance", "mutual_capacitance", "differential", "single_ended", "rc_oscillation", "charge_discharge", "sigma_delta", "lc_resonance", "four_wire", "two_wire", "bridge", "divider"]
        // },
        // "interface": { "type": "string", "enum": ["internal", "i2c", "spi", "gpio", "adc", "other"] },
        // "adc_bits": { "type": "integer", "minimum": 1, "maximum": 32 },
        // "adc_attenuation_db": { "type": "number" },
        // "adc_reference_v": { "type": "number", "exclusiveMinimum": 0 },
        // "adc_calibrated": { "type": "boolean" },
        // "gain": { "type": "number", "exclusiveMinimum": 0 },
        // "range_index": { "type": "integer", "minimum": 0 },
        // "range_min": { "type": "number" },
        // "range_max": { "type": "number" },
        // "auto_ranging": { "type": "boolean" },
        // "oversampling": { "type": "integer", "minimum": 1 },
        // "conversion_time_us": { "type": "number", "minimum": 0 },
        // "reference_resistor_ohm": { "type": "number", "exclusiveMinimum": 0 },
        // "reference_capacitor_pf": { "type": "number", "exclusiveMinimum": 0 },
        // "shield_driven": { "type": "boolean", "description": "Active shield/guard driven to remove stray capacitance." },
        // "offset_capacitance_pf": { "type": "number", "description": "Programmed offset (e.g. FDC1004 CAPDAC)." },
        // "touch_pad": {
        //   "type": "object",
        //   "description": "ESP32 touch-sensor peripheral settings.",
        //   "additionalProperties": false,
        //   "properties": {
        //     "pad": { "type": "integer", "minimum": 0 },
        //     "charge_voltage_high": { "type": "string" },
        //     "charge_voltage_low": { "type": "string" },
        //     "slope": { "type": "integer" },
        //     "measurement_cycles": { "type": "integer", "minimum": 1 },
        //     "sleep_cycles": { "type": "integer", "minimum": 0 },
        //     "denoise_enabled": { "type": "boolean" },
        //     "filter_mode": { "type": "string" },
        //   }
        // },
        // "excitation": { "$ref": "#/$defs/excitation" },
      }
    },
    "electrode": {
      "type": "object",
      "description": "Physical sensing element.",
      "additionalProperties": false,
      "properties": {
        // "electrode_id": { "$ref": "#/$defs/id" },
        // "role": { "type": "string", "enum": ["sense", "drive", "reference", "guard", "shield", "compensation", "ground"] },
        // "geometry": {
        //   "type": "string",
        //   "enum": ["interdigitated", "parallel_plate", "coplanar", "ring", "wire_grid", "pad", "pcb_trace", "fin_clamp", "probe", "other"]
        // },
        // "mounting": {
        //   "type": "string",
        //   "enum": ["fin_surface", "between_fins", "tube_surface", "drain_pan", "air_stream", "duct_wall", "other"]
        // },
        // "area_mm2": { "type": "number", "exclusiveMinimum": 0 },
        // "gap_mm": { "type": "number", "exclusiveMinimum": 0 },
        // "finger_count": { "type": "integer", "minimum": 1 },
        // "cable_length_m": { "type": "number", "minimum": 0 },
        // "coating": { "type": "string", "enum": ["none", "conformal", "parylene", "soldermask", "hydrophobic", "other"] },
        // "position": {
        //   "type": "object",
        //   "additionalProperties": false,
        //   "properties": {
        //     "x_mm": { "type": "number" },
        //     "y_mm": { "type": "number" },
        //     "z_mm": { "type": "number" },
        //     "row": { "type": "integer", "minimum": 0 },
        //     "fin_index": { "type": "integer", "minimum": 0 },
        //     "tube_index": { "type": "integer", "minimum": 0 },
        //     "description": { "type": "string", "maxLength": 128 },
        //   }
        // },
      }
    },
    "capacitive": {
      "type": "object",
      "description": "Capacitive sensing result. Ice (eps_r ~3.2) vs water (eps_r ~80) vs air (~1) changes the measured capacitance in distinguishable ways.",
      "additionalProperties": false,
      "properties": {
        "raw_counts": { "type": "number", "description": "Raw value of the sensing peripheral (touch counts, CDC code, ADC code)." },
        // "raw_frequency_hz": { "type": "number", "minimum": 0, "description": "Oscillator frequency for RC/LC oscillator based sensing." },
        // "raw_period_us": { "type": "number", "minimum": 0 },
        // "charge_time_us": { "type": "number", "minimum": 0 },
        // "discharge_time_us": { "type": "number", "minimum": 0 },
        // "capacitance_pf": { "type": "number", "minimum": 0 },
        // "capacitance_filtered_pf": { "type": "number", "minimum": 0 },
        // "capacitance_compensated_pf": { "type": "number", "description": "After temperature / parasitic / drift compensation." },
        // "delta_pf": { "type": "number", "description": "Compensated capacitance minus baseline." },
        "delta_pct": { "type": "number", "description": "Relative change vs baseline; for this FDC2214 LC sensor, derived from the squared inverse frequency-code ratio." },
        // "baseline_pf": { "type": "number", "minimum": 0 },
        // "baseline_ts": { "$ref": "#/$defs/epoch_ms" },
        // "baseline_age_s": { "type": "integer", "minimum": 0 },
        // "parasitic_pf": { "type": "number" },
        // "shield_pf": { "type": "number" },
        // "reference_pf": { "type": "number", "description": "Reading of a reference/compensation electrode in the same environment." },
        // "differential_pf": { "type": "number", "description": "Sense minus reference." },
        // "mutual": {
        //   "type": "object",
        //   "additionalProperties": false,
        //   "properties": {
        //     "tx_electrode_id": { "$ref": "#/$defs/id" },
        //     "rx_electrode_id": { "$ref": "#/$defs/id" },
        //     "coupling_pf": { "type": "number" },
        //   }
        // },
        // "relative_permittivity_est": { "type": "number", "minimum": 1, "description": "Effective permittivity estimated from the geometry model." },
        // "normalized": { "type": "number", "description": "0 = clear baseline, 1 = full-scale ice reference." },
        // "temperature_compensation": {
        //   "type": "object",
        //   "additionalProperties": false,
        //   "properties": {
        //     "applied": { "type": "boolean" },
        //     "reference_temperature_c": { "type": "number" },
        //     "coefficient_ppm_per_k": { "type": "number" },
        //     "temperature_used_c": { "type": "number" },
        //   }
        // },
      }
    },
    "resistive": {
      "type": "object",
      "description": "Resistive / conductive sensing result (liquid water film vs ice vs dry surface).",
      "additionalProperties": false,
      "properties": {
        // "raw_adc": { "type": "number" },
        "voltage_v": { "type": "number", "description": "MCP3426 differential voltage: sensor-node input minus the shared midpoint reference." },
        // "current_ua": { "type": "number" },
        "resistance_ohm": { "type": "number", "minimum": 0, "description": "Sensor resistance inferred from the divider and MCP3426 input-impedance model using the window-mean voltage." },
        // "resistance_filtered_ohm": { "type": "number", "minimum": 0 },
        // "conductance_us": { "type": "number", "minimum": 0 },
        // "delta_ohm": { "type": "number" },
        "delta_pct": { "type": "number" },
        "baseline_ohm": { "type": "number", "minimum": 0 },
        // "baseline_ts": { "$ref": "#/$defs/epoch_ms" },
        // "baseline_age_s": { "type": "integer", "minimum": 0 },
        "log10_resistance": { "type": "number", "description": "Base-10 log of the inferred per-side resistance; handy when resistance spans decades." },
        // "surface_resistance_ohm_sq": { "type": "number", "minimum": 0 },
        // "resistivity_ohm_m": { "type": "number", "minimum": 0 },
        // "polarity": { "type": "string", "enum": ["positive", "negative", "alternating"] },
        // "forward_resistance_ohm": { "type": "number", "minimum": 0 },
        // "reverse_resistance_ohm": { "type": "number", "minimum": 0 },
        "open_circuit": { "type": "boolean", "description": "Resistance reached the upper model bound; normally indicates a dry sensor." },
        "short_circuit": { "type": "boolean" },
        // "saturated": { "type": "boolean" },
        // "leakage_current_na": { "type": "number" },
      }
    },
    "impedance": {
      "type": "object",
      "description": "Complex impedance at one frequency, or a sweep. Frequency dependence separates liquid water, ice and frost.",
      "additionalProperties": false,
      "properties": {
        // "frequency_hz": { "type": "number", "exclusiveMinimum": 0 },
        // "magnitude_ohm": { "type": "number", "minimum": 0 },
        // "phase_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        // "real_ohm": { "type": "number" },
        // "imag_ohm": { "type": "number" },
