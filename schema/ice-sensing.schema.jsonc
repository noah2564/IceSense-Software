    "ice_assessment": {
      "type": "object",
      "description": "On-device interpretation of the sensor data. May be absent if all evaluation is done in the backend.",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["clear", "dry", "wet", "condensation", "frost_onset", "frost", "ice", "heavy_ice", "blocked", "melting", "unknown"]
        },
        // "confidence": { "$ref": "#/$defs/unit_interval" },
