        //       "y": { "type": "number" },
        //       "label": { "type": "string", "maxLength": 32 },
        //     }
        //   }
        // },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            // "offset": { "type": "number" },
            // "gain": { "type": "number" },
            "baseline_value": { "type": "number" },
            "baseline_unit": { "type": "string", "maxLength": 16 },
            // "coefficients": { "type": "array", "items": { "type": "number" } },
            // "residual_rms": { "type": "number", "minimum": 0 },
            "noise_floor": { "type": "number", "minimum": 0 },
            "samples_used": { "type": "integer", "minimum": 0 },
          }
        },
        // "error_code": { "type": "string", "maxLength": 32 },
        // "message": { "type": "string", "maxLength": 256 },
      }
    },
    "diagnostic": {
      "type": "object",
      "description": "Self-test and electrode / wiring integrity results.",
      "required": ["diagnostic_type", "results"],
      "additionalProperties": false,
      "properties": {
